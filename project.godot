; Engine configuration file.
; Edit project settings through the Godot editor when possible.

config_version=5

[application]

config/name="Stoneborn"
run/main_scene="res://scenes/world/main.tscn"
config/features=PackedStringArray("4.0", "GL Compatibility")

[autoload]

Inventory="*res://autoload/inventory.gd"
Crafting="*res://autoload/crafting.gd"

[input]

move_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_back={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
sprint={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
toggle_crafting={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":67)]
}
place_campfire={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":70)]
}
debug_give_raw_meat={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":71)]
}
eat={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":82)]
}

place_water_filter={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":72)]
}
toggle_build={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":66)]
}
build_place={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":1)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/size.mobile=1024
